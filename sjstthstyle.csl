<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Suranaree Journal of Science and Technology Journal Style</title>
    <id>http://www.zotero.org/styles/sjstjournalth-style</id>
    <link href="http://www.zotero.org/styles/sjstjournalth-style" rel="self"/>
    <author>
      <name>Nathaphan Meemuk</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2024-05-20T12:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=" "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", (" suffix=")"/>
    </names>
  </macro>

  <macro name="year-date">
    <choose>
      <variable variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </variable>
      <otherwise>
        <text term="no date" form="short"/>
      </otherwise>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <is-numeric variable="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </is-numeric>
      <otherwise>
        <text variable="edition"/>
      </otherwise>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="year-date"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="year-date"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key macro="year-date"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="year-date" prefix="(" suffix=")"/>
      </group>
      
      <choose>
        <if type="article-journal">
          <text variable="title" prefix=" " suffix="."/>
          <group prefix=" " delimiter=", ">
            <text variable="container-title" form="short"/>
            <group delimiter="">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
              <text variable="page" prefix=":"/>
            </group>
          </group>
        </if>

        <else-if type="book">
          <group delimiter=". " prefix=" ">
            <text variable="title"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text variable="number-of-pages" suffix="p"/>
          </group>
        </else-if>

        <else-if type="chapter">
          <text variable="title" prefix=" " suffix="."/>
          <group prefix=" " delimiter=". ">
            <group delimiter=": ">
              <text term="in" capitalize-first="true"/>
              <text variable="container-title"/>
            </group>
            <text macro="editor"/>
            <text macro="publisher"/>
            <text variable="page" prefix="p. "/>
          </group>
        </else-if>

        <else-if type="thesis">
          <text variable="title" prefix=" " suffix=","/>
          <group prefix=" [" suffix="]." delimiter=", ">
            <text variable="genre"/>
          </group>
          <group prefix=" " delimiter=", ">
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text variable="number-of-pages" suffix="p"/>
          </group>
          <text variable="archive" prefix=". "/>
        </else-if>

        <else-if type="paper-conference">
          <text variable="title" prefix=" " suffix=","/>
          <group prefix=" " delimiter="; ">
            <text variable="container-title" prefix="Proceedings of the "/>
            <date variable="issued" delimiter=" ">
              <date-part name="month"/>
              <date-part name="day"/>
              <date-part name="year" prefix=", "/>
            </date>
            <text variable="event-place"/>
          </group>
          <text variable="page" prefix=", p. "/>
        </else-if>

        <else-if type="patent">
          <group delimiter="; " prefix=" ">
            <names variable="author">
              <name delimiter=", " initialize-with="."/>
              <label form="static" prefix=", " suffix="inventor"/>
            </names>
            <text variable="publisher" suffix=", assignee"/>
          </group>
          <date variable="issued" prefix=" " suffix=". ">
            <date-part name="month" suffix=" "/>
            <date-part name="day" suffix=", "/>
            <date-part name="year"/>
          </date>
          <text variable="title" suffix="."/>
          <group prefix=" " delimiter=" ">
            <text variable="authority"/>
            <text variable="number" prefix="patent no. "/>
          </group>
        </else-if>

        <else-if type="webpage post-weblog article-journal" variable="URL">
           <text variable="title" prefix=" " suffix="."/>
           <text variable="container-title" prefix=" " form="short"/>
           <text value="[serial online]" prefix=" "/>
           <group prefix="; " delimiter="">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
              <text variable="page" prefix=":"/>
            </group>
            <text variable="URL" prefix=". Available from: "/>
            <date variable="accessed" prefix=". Accessed date: " delimiter=" ">
              <date-part name="month" form="short"/>
              <date-part name="day" suffix=", "/>
              <date-part name="year"/>
            </date>
        </else-if>

        <else>
          <text variable="title" prefix=" " suffix="."/>
          <group prefix=" " delimiter=", ">
            <text variable="container-title"/>
            <text macro="publisher"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
